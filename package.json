{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "bun run build && bun run db:migrate:local && wrangler dev",
    "dev:ui": "next dev",
    "build": "next build",
    "start": "wrangler dev",
    "preview": "wrangler dev",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "bun test src",
    "test:worker": "bun build ./worker/index.ts --target=browser --outfile=.wrangler/test-worker.mjs && node --test worker/check-d1.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "@types/three": "^0.183.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "miniflare": "5.20261019.1-beta",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.151.3"
  }
}
